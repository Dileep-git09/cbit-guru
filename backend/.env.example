# ---------------------------------------------------------------------------
# CBIT Guru — backend environment TEMPLATE
# Copy this to `.env` (same folder) and fill in real values.
# NEVER commit the real .env — it is gitignored for a reason.
# ---------------------------------------------------------------------------

# --- Google Gemini (embeddings: gemini-embedding-001, 3072 dims) ---
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=3072

# --- Cohere (generator LLM) ---
# Free trial key: https://dashboard.cohere.com/api-keys
COHERE_API_KEY=your_cohere_api_key_here
COHERE_MODEL=command-r-08-2024

# --- Qdrant vector database ---
# Local Docker:  http://localhost:6333   (leave QDRANT_API_KEY blank)
# Qdrant Cloud:  https://xxxx.qdrant.io  (+ paste the cluster API key)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=cbit_guru_rag

# --- Retrieval tuning (report Section 3.4.4) ---
TOP_K=8
IMAGE_TOP_K=5
SCORE_THRESHOLD=0.35
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
MAX_PDF_CHARS=50000

# --- Admin panel ---
ADMIN_EMAIL=admin@cbit.ac.in
ADMIN_PASSWORD=change_me_now
JWT_SECRET=generate_a_random_hex_string_here
JWT_EXPIRE_MINUTES=720

# --- CORS (which frontend origins may call the API) ---
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Scaling for many concurrent students ---
# Caps on simultaneous outbound calls to each API, shared across every
# request this process handles at once — protects the shared free-tier
# quota from a burst of students asking at the same instant.
GEMINI_MAX_CONCURRENCY=5
COHERE_MAX_CONCURRENCY=5
# Response cache: repeat/near-repeat questions skip real API calls entirely.
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600
CACHE_MAX_SEMANTIC_ENTRIES=200
CACHE_SEMANTIC_THRESHOLD=0.97
# Per-IP requests/minute to /api/chat*. 0 disables the limiter.
CHAT_RATE_LIMIT_PER_MINUTE=30

# --- Scraper ---
SCRAPE_ROOT_URL=https://www.cbit.ac.in
SCRAPE_MAX_PAGES=150
SCRAPE_OUTPUT_DIR=data
