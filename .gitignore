# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# --- Secrets: NEVER commit real keys ---
backend/.env
# backend/instance/ holds admin.db (bcrypt password hashes) — never commit
backend/instance/

# --- Regenerable data (scraper output — regenerate with `python -m scraper.crawl`) ---
backend/data/text_content/*
backend/data/pdfs/*
backend/data/images/*
!backend/data/**/.gitkeep

# --- Node / frontend ---
node_modules/
frontend/dist/
frontend/.vite/

# --- OS / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json
.claude/
